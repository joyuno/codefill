# CodeFill Backend Environment Variables

# Supabase (필수)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
FRONTEND_URL=http://localhost:3000

# LLM (추후 설정 - AI 기능 활성화 시)
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Judge0 (RapidAPI - 코드 실행)
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=여기에_RapidAPI_키_입력
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# App
DEBUG=true
APP_NAME=CodeFill API
APP_VERSION=1.0.0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Kakao OAuth (카카오 로그인)
KAKAO_CLIENT_ID=여기에_REST_API_키_입력
KAKAO_CLIENT_SECRET=여기에_Client_Secret_입력
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# Google OAuth (구글 로그인)
GOOGLE_CLIENT_ID=여기에_Google_Client_ID_입력
GOOGLE_CLIENT_SECRET=여기에_Google_Client_Secret_입력
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# GitHub OAuth (깃허브 로그인)
GITHUB_CLIENT_ID=여기에_GitHub_Client_ID_입력
GITHUB_CLIENT_SECRET=여기에_GitHub_Client_Secret_입력
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Azure Translator (번역 API)
AZURE_TRANSLATOR_KEY=여기에_Azure_Translator_키_입력
AZURE_TRANSLATOR_REGION=koreacentral
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Cache TTL (PostgreSQL 캐시)
CACHE_TTL_RECOMMENDATIONS=300
CACHE_TTL_USER_PREFERENCES=600

# LangSmith (LangGraph 추적/평가)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=여기에_LangSmith_API_키_입력
LANGCHAIN_PROJECT=codefill-dev