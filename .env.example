# ===========================================
# CodeFill Environment Variables
# ===========================================

# Supabase Configuration
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter Configuration (for LLM)
# Get this from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenAI Configuration (for Embeddings)
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret

# Judge0 Configuration (for Python/Java/C++ code execution)
# Self-hosted or use RapidAPI: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-judge0-api-key

# Sentry Configuration (optional, for error tracking)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
