# ===========================================
# CodeFill Environment Variables
# ===========================================

# Supabase Configuration
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter Configuration (for LLM)
# Get this from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenAI Configuration (for Embeddings)
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret

# Judge0 Configuration (for Python/Java/C++ code execution)
# Get API key from: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Sentry Configuration (optional, for error tracking)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ===========================================
# Analytics Configuration
# ===========================================

# Microsoft Clarity (세션 리플레이, 히트맵)
# Get from: https://clarity.microsoft.com → Setup → Get tracking code
NEXT_PUBLIC_CLARITY_ID=your-clarity-project-id

# Google Analytics 4 (이벤트 추적, 퍼널)
# Get from: https://analytics.google.com → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
